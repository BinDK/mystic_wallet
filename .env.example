# Copy to .env (loaded by dotenv-rails). Never commit .env.

# --- Local database (pg18 container on 5435) ---
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=password

# --- Production / Neon ---
# Used when RAILS_ENV=production. Use Neon's DIRECT url (no -pooler) for db:migrate.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# RAILS_MASTER_KEY=   # or keep config/master.key; needed for credentials (mocking password, api_key)

# --- Sidekiq ---
REDIS_URL=redis://localhost:6379/0

# --- Data generator jobs (same switches as cf-port) ---
USER_CREATABLE=false
TRANSACTION_CREATABLE=false
TRANSACTIONS_CREATE_COUNT=50

# --- Server (optional) ---
# PORT=3000
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
